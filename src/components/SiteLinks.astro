---
import NaiveIcon from './preact/NaiveIcon';
import { siteLinks } from '../lib/links';

const links = siteLinks.map((link) => ({ ...link, host: new URL(link.url).hostname }));
---

<ul class="links-grid">
	{
		links.map(({ name, url, relation, desc, owner, ownerAvatar, facts, icon, accent, host }) => (
			<li>
				<a class="site-card" href={url} target="_blank" rel="noopener noreferrer">
					<p class="eyebrow">{relation}</p>

					<div class="head">
						<span class="badge" style={`--badge: ${accent}`}>
							<NaiveIcon name={icon} size="1.9rem" />
						</span>
						<div class="heading">
							<h3 class="name">{name}</h3>
							<span class="owner">
								<img class="avatar" src={ownerAvatar} alt="" width="40" height="40" />
								<span class="owner-text">{owner}</span>
								<span class="verified">
									<NaiveIcon name="badge-check" size="1.05em" color={accent} />
								</span>
							</span>
						</div>
					</div>

					<p class="desc">{desc}</p>

					<ul class="facts">
						{facts.map((fact) => (
							<li>{fact}</li>
						))}
					</ul>

					<div class="foot">
						<span class="host">{host}</span>
						<span class="cta">
							去看看
							<span class="go">
								<NaiveIcon name="arrow-up-right" size="1.1rem" />
							</span>
						</span>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style lang="scss">
	.links-grid {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-card {
		/* 略微不对称的圆角，保留手绘的笨拙感 */
		border-radius: 1.75rem 1.5rem 1.7rem 1.55rem;
		display: grid;
		gap: 1rem;
		height: 100%;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		background: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
		color: var(--gray-0);
		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;

		&:hover,
		&:focus-visible {
			transform: translateY(-3px);
			border-color: var(--accent-regular);
			box-shadow: var(--shadow-md);
		}
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		color: var(--gray-400);
	}

	.head {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.badge {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 3.75rem;
		height: 3.75rem;
		/* 不规则的“手画圆” */
		border-radius: 52% 48% 45% 55% / 48% 55% 45% 52%;
		border: 2px solid var(--badge);
		background: var(--gray-999);
		box-shadow: var(--shadow-sm);
		transition: transform 0.3s ease;
	}

	.site-card:hover .badge,
	.site-card:focus-visible .badge {
		transform: rotate(-8deg) scale(1.06);
	}

	.heading {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.name {
		margin: 0;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--gray-0);
	}

	.owner {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.avatar {
		width: 1.5rem;
		height: 1.5rem;
		flex: 0 0 auto;
		object-fit: cover;
		border-radius: 50% 46% 54% 48%;
		border: 1px solid var(--gray-800);
	}

	.owner-text,
	.verified {
		display: inline-flex;
		align-items: center;
	}

	.desc {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--gray-300);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			padding: 0.2rem 0.65rem;
			font-size: 0.75rem;
			color: var(--gray-400);
			border: 1px dashed var(--gray-700);
			border-radius: 999rem;
		}
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--gray-800);
	}

	.host {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		color: var(--gray-500);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--accent-regular);
	}

	.go {
		display: inline-flex;
		transition: transform 0.25s ease;
	}

	.site-card:hover .go,
	.site-card:focus-visible .go {
		transform: translate(3px, -3px);
	}

	@media (min-width: 50em) {
		.links-grid {
			/* 上限 34rem，避免只有一张卡时被拉成整行 */
			grid-template-columns: repeat(auto-fit, minmax(24rem, 34rem));
			justify-content: center;
			gap: 1.5rem;
		}

		.site-card {
			padding: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-card,
		.badge,
		.go {
			transition: none;
		}

		.site-card:hover,
		.site-card:focus-visible {
			transform: none;
		}

		.site-card:hover .badge,
		.site-card:focus-visible .badge {
			transform: none;
		}

		.site-card:hover .go,
		.site-card:focus-visible .go {
			transform: none;
		}
	}
</style>
