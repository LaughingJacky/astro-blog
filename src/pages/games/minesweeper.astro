---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MineSweeper from '../../components/Minesweep';

Astro.response.headers.set('Cache-Control', 's-maxage=86400, stale-while-revalidate=604800');
---

<BaseLayout title="扫雷 | 王晓博" description="经典扫雷">
	<main class="wrapper game-page">
		<MineSweeper client:load />
	</main>
</BaseLayout>

<style lang="scss">
	.game-page {
		display: flex;
		justify-content: center;
		padding-block: 4rem 6rem;
	}
</style>
